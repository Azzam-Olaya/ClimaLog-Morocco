# URL de l'API météo (gratuite, pas besoin de clé)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Chemin du dossier bronze
BRONZE_DIR=data/bronze

# Fichier des villes marocaines
CITIES_CSV=ma.csv

# On garde uniquement les villes avec plus de 100 000 habitants
MIN_POPULATION=100000

# Nombre de jours de prévision à récupérer
FORECAST_DAYS=7

# Timeout en secondes pour chaque appel API
API_TIMEOUT=10

# Nombre de tentatives si l'API ne répond pas
API_RETRIES=3
